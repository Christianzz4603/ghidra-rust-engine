<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.reversepp.app">
    <!-- Reverse++ reads and patches binaries that live in shared storage. On Android 11+ this is the
         "All files access" special permission, which you grant once under Settings > Apps >
         Special app access > All files access. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="Reverse++"
        android:hasCode="false"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name="android.app.NativeActivity"
            android:label="Reverse++"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="reverse_pp_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
