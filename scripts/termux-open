#!/system/bin/sh
set -eu

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
DECOMPILER="$PREFIX/bin/ghidra-decompiler"

if [ "$#" -ne 1 ]; then
    printf 'Usage: open <file>\n' >&2
    exit 2
fi

if [ ! -x "$DECOMPILER" ]; then
    printf 'ghidra-decompiler is not installed. Run scripts/install-termux.sh from the repository.\n' >&2
    exit 127
fi

FILE=$1
case "$FILE" in
    /*) ;;
    *) FILE="$PWD/$FILE" ;;
esac

if [ ! -f "$FILE" ]; then
    printf 'File not found: %s\n' "$FILE" >&2
    exit 1
fi

TMP_DIR="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$TMP_DIR"
INIT_SCRIPT=$(mktemp "$TMP_DIR/ghidra-open.XXXXXX")
trap 'rm -f "$INIT_SCRIPT"' EXIT HUP INT TERM

# The console's command parser accepts a single filename token.
printf 'open %s\n' "$FILE" > "$INIT_SCRIPT"
"$DECOMPILER" -i "$INIT_SCRIPT"
